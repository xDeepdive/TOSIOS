# TOSIOS Client Environment Variables

# Server WebSocket URL (for production deployment)
# Example for Railway: wss://tosios-server-production.up.railway.app
# Example for Render: wss://tosios-server.onrender.com
# Leave empty for local development (will use localhost:3001)
VITE_SERVER_URL=

# Alternative variable name (for compatibility)
REACT_APP_SERVER_URL=
